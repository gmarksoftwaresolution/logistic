{
  "name": "logistic-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Logistic Monorepo Platform",
  "workspaces": [
    "apps/*",
    "backend/*"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev --workspace=@logistic/backend",
    "gmu-hub:dev": "npm run dev --workspace=frontend",
    "shg-app:start": "node backend/app/scripts/update-ip.js && npm start --workspace=@logistic/shg-app -- --clear",
    "shg-app:start-tunnel": "node backend/app/scripts/update-ip.js && npm start --workspace=@logistic/shg-app -- --tunnel --clear",
    "transporter-app:start": "node backend/app/scripts/update-ip.js && npm start --workspace=@logistic/transporter-app -- --port 8082 --clear",
    "transporter-app:start-tunnel": "node backend/app/scripts/update-ip.js && npm start --workspace=@logistic/transporter-app -- --port 8082 --tunnel --clear",
    "db:generate": "prisma generate --schema=backend/app/prisma/schema.prisma",
    "db:push": "prisma db push --schema=backend/app/prisma/schema.prisma",
    "seed:pincode": "ts-node backend/app/prisma/seed-pincode.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "react-refresh": "^0.18.0",
    "vite": "^8.1.4"
  }
}
