{
  "expo": {
    "name": "Delivery Partner App",
    "slug": "shg-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/GMU Logo Splash.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/GMU Logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gmu.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow this app to access your location to auto-fill address details."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/GMU Logo.png",
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-localization",
      "expo-font"
    ],
    "owner": "mahendra7649",
    "extra": {
      "eas": {
        "projectId": "f41780dc-8cf3-49fa-a2d0-978de1537544"
      }
    }
  }
}
